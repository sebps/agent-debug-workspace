{
  "name": "agent-debug-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "pack": "npm run build && npm pack ./agent-debug",
    "publish": "npm publish ./agent-debug",
    "build": "npm install && npm install --prefix agent-debug && npm install --prefix agent-debug-ui && npx gulp build",
    "install:test": "LATEST_TGZ=$(ls -t *.tgz | head -1) && npm install --prefix agent-debug-test \"$LATEST_TGZ\"",
    "test": "npm install --prefix agent-debug-test && node --inspect agent-debug-test/index.js",
    "ui:dev": "npm run dev --prefix agent-debug-ui"
  },
  "devDependencies": {
    "del": "^7.1.0",
    "gulp": "^5.0.0",
    "open": "^11.0.0"
  }
}
